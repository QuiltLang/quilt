#!/usr/bin/env quilt
//! Generate Lean 4 *data* declarations -- an `inductive` and a `structure` --
//! together with the functions and theorems that go with them, all from one
//! Rust-side schema.
//!
//! The other Lean examples generate `def`s and theorems; this one covers the
//! declaration forms that introduce new types, and shows exactly where Quilt's
//! structural approach stops and host-side assembly takes over.
//!
//! ## Where the boundary is
//!
//! A constructor list (`| red | green | blue`) and a field list (`red : Nat`)
//! are variable-length, and neither is a Variadic container in Lean's grammar
//! -- only `by` and `do` are. Nor is either a standalone parseable fragment:
//! `lean↖| Color.red => 0↗` and `lean↖red : Nat↗` are both parse errors,
//! because Lean's `module` holds *commands*, and a bare arm or binder is
//! neither a command nor a term. So the constructor and field lines are built
//! as host strings and joined -- the same idiom `lean_specialize.rs.quilt`
//! uses for declaration sequences. Issue #133 covers the grammar change that
//! would make them structural.
//!
//! *Everything else* is a real QTerm. Note in particular that the two
//! variable-length **terms** are folds, not string joins:
//!
//!   * `Color.code` is a right-nested `if … then … else …` chain, one arm per
//!     channel, folded at generation time; and
//!   * `Palette.total` is a folded `+` chain over the projections.
//!
//! Choosing `if`/`else` over a `match` is what makes that possible: the fold
//! composes complete Lean *terms* at every step, so each one is parsed and
//! checked by the Lean grammar as it is built. A `match` would have forced the
//! whole body into the string path.
//!
//! The theorems are the point of the exercise: `Color.code_lt` states a bound
//! that *is* generation-time data (the number of channels), and Lean proves it
//! by `cases … <;> decide` -- so if the schema and the generated bound ever
//! disagreed, the generated file would fail to compile.
use quilt::prelude::*;

/// A Lean identifier term, for splicing into name position.
fn ident(s: &str) -> Arc<QTerm> {
    leaf("identifier", s)
}

fn main() -> Result<()> {
    // The schema, fixed at generation time. Everything below follows from it.
    let channels = ["red", "green", "blue"];
    let n = u32::try_from(channels.len()).unwrap();

    let mut decls: Vec<String> = Vec::new();

    // --- The two declarations that need host-side assembly (see header). ---

    let ctors = channels
        .iter()
        .map(|c| format!("  | {c}"))
        .collect::<Vec<_>>()
        .join("\n");
    decls.push(format!(
        "inductive Color where\n{ctors}\n  deriving Repr, DecidableEq"
    ));

    let fields = channels
        .iter()
        .map(|c| format!("  {c} : Nat"))
        .collect::<Vec<_>>()
        .join("\n");
    decls.push(format!(
        "structure Palette where\n{fields}\n  deriving Repr, DecidableEq"
    ));

    // --- From here on everything is built structurally, as QTerms. ---

    // `Color.code`: a right-nested if/else chain, folded from the last channel
    // backwards. The final `else` is the last channel's index, so the chain
    // has one test fewer than there are channels.
    let last = u32::try_from(channels.len() - 1).unwrap();
    let mut code = lean↖↙last.↑↘↗;
    for (i, ch) in channels.iter().enumerate().rev().skip(1) {
        let ctor = ident(&format!("Color.{ch}"));
        let idx = u32::try_from(i).unwrap();
        code = lean↖if c = ↙ctor↘ then ↙idx.↑↘ else ↙code↘↗;
    }
    decls.push(lean↖def Color.code (c : Color) : Nat := ↙code↘↗.coparse());

    // The bound is the channel count, lifted out of the Rust list. `decide`
    // closes each case, so a wrong bound would be a compile error downstream.
    decls.push(
        lean↖theorem Color.code_lt (c : Color) : c.code < ↙n.↑↘ := by
          cases c <;> decide↗
        .coparse(),
    );

    // `Palette.total`: a folded `+` over the field projections. The projection
    // is built host-side as one identifier -- `p.↙ch↘` would work too, but a
    // whole name is clearer and matches how the other Lean examples do it.
    let mut total = ident(&format!("p.{}", channels[0]));
    for ch in &channels[1..] {
        let proj = ident(&format!("p.{ch}"));
        total = lean↖↙total↘ + ↙proj↘↗;
    }
    decls.push(lean↖def Palette.total (p : Palette) : Nat := ↙total↘↗.coparse());

    // State what `total` computes on a literal `Palette.mk`. True by `rfl`:
    // `total` is a plain sum, so both sides are definitionally equal.
    //
    // The right-hand side is a folded `+` over the binder names, and the
    // constructor call is a folded *application* -- both are terms, so both
    // are built structurally.
    let mut rhs = ident(channels[0]);
    let mut mk = ident("Palette.mk");
    for ch in &channels[1..] {
        let arg = ident(ch);
        rhs = lean↖↙rhs↘ + ↙arg↘↗;
    }
    for ch in channels {
        let arg = ident(ch);
        mk = lean↖↙mk↘ ↙arg↘↗;
    }
    // The binder group `(red green blue : Nat)` is *not* a term -- it is the
    // same non-Variadic, non-standalone shape as the field list above, so it
    // is assembled host-side and spliced as one leaf.
    let binder_group = leaf("identifier", &channels.join(" "));
    // `mk` is an application, so it is parenthesised before `.total`: a splice
    // carries a term, not a precedence level.
    decls.push(
        lean↖theorem Palette.total_mk (↙binder_group↘ : Nat) : (↙mk↘).total = ↙rhs↘ := by rfl↗
        .coparse(),
    );

    // `main`, emitted statement by statement into the do-block -- one line per
    // channel, reporting the code Lean computed for it.
    //
    // Note the channel name is *lifted* into a Lean string literal and
    // concatenated, rather than spliced into an `s!"…"` interpolation. A hole
    // cannot go inside a string literal: Lean's grammar lexes the whole
    // literal as one token, so `__QUILT_HOLE__` inside it never becomes a node
    // for Quilt to plug. Interpolating Lean's *own* values (`{…}` over a Lean
    // binder, as in the `total` line below) is fine -- that is Lean's
    // interpolation, evaluated at Lean runtime, not a Quilt splice.
    let main = lean↖def main : IO Unit := do
        ↙{
            for ch in channels {
                let ctor = ident(&format!("Color.{ch}"));
                lean↖IO.println (↙ch.↑↘ ++ " -> " ++ toString (↙ctor↘).code)↗.←;
                NL.←;
            }
            lean↖IO.println s!"total = {(Palette.mk 1 2 3).total}"↗.←;
        }↘↗;
    decls.push(main.coparse());

    println!("{}", decls.join("\n\n"));
    Ok(())
}
