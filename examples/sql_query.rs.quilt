#!/usr/bin/env quilt
//! Build sanitized SQL queries from a Rust host.
//!
//! SQL is a *target* language in Quilt: it only appears inside sql quote
//! brackets embedded in a host language (here, Rust). Quilt parses each
//! fragment into a QTerm, the Rust host splices values in, and .coparse()
//! serializes the tree back to plain SQL.
//!
//! The reason to do this rather than build a query with format! is what
//! crossing the boundary means. A value enters the query through the lift
//! operator -- a postfix written between the unquote brackets -- which turns it
//! into a *literal node*, not into text. A string becomes one `literal` token
//! whose spelling is standard SQL with every quote doubled, so a value cannot
//! close the literal and continue the statement. The last query below is built
//! from a name chosen to break out of a format!-assembled string; it comes back
//! as a single literal instead.
//!
//! Composition works at two levels: a whole statement is a fragment, and so is
//! a bare predicate -- `sql↖a = 1↗` parses even though SQL's own grammar has no
//! place for an expression on its own.
use quilt::prelude::*;

/// One filter the report can apply, as a Rust value.
enum Filter {
    Org(&'static str),
    MinAge(u32),
    Active(bool),
}

impl Filter {
    // Turn a filter into a SQL predicate fragment: a bare expression quote,
    // with the value placed by a lift.
    fn predicate(&self) -> Arc<QTerm> {
        // `*self`, not `self`: every payload here is `Copy`, and matching
        // through the reference binds `&&str` / `&u32`, which the lift cannot
        // see through — `LiftTo` is implemented for `str`, not for `&str`.
        match *self {
            Filter::Org(name) => sql↖org = ↙name.↑↘↗,
            Filter::MinAge(n) => sql↖age >= ↙n.↑↘↗,
            Filter::Active(b) => sql↖active = ↙b.↑↘↗,
        }
    }
}

/// `SELECT id, name FROM members WHERE <conjunction of the filters>`.
///
/// The predicates are combined at *generation* time by folding the Rust list,
/// so the emitted query is one flat statement with no runtime assembly left in
/// it.
fn report(filters: &[Filter]) -> Arc<QTerm> {
    let mut pred = sql↖TRUE↗;
    for f in filters {
        let rhs = f.predicate();
        pred = sql↖↙pred↘ AND ↙rhs↘↗;
    }
    // Bound rather than returned directly: a *statement* quote sitting in Rust
    // tail position is the shape the expander reads as "emit me into the
    // enclosing builder" (see the `is_stmt_like` heuristic in `multi.rs`), which
    // is right inside an emit loop and wrong for a return value.
    let query = sql↖SELECT id, name FROM members WHERE ↙pred↘↗;
    query
}

fn main() -> Result<()> {
    // An ordinary report. Three Rust values of three different types, each
    // crossing into the query as the SQL literal for its own type.
    let q = report(&[
        Filter::Org("acme"),
        Filter::MinAge(21),
        Filter::Active(true),
    ]);
    println!("{};", q.coparse());

    // A value containing the delimiter. Standard SQL escapes a quote by
    // doubling it, which is exactly what the lift emits -- and what the
    // grammar's own string rule accepts, so the result reparses to the same
    // text.
    let q = report(&[Filter::Org("Bob's Bakery")]);
    println!("{};", q.coparse());

    // The case the whole exercise is for. Pasted into a format!-built query
    // this name ends the literal, closes the statement and comments out the
    // rest; lifted, it is one literal token and the query still has exactly
    // one predicate.
    let q = report(&[Filter::Org("x'; DROP TABLE members; --")]);
    println!("{};", q.coparse());

    Ok(())
}
