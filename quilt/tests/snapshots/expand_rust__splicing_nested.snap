{
    fn mk(i: usize) -> Result<Arc<QTerm>> {
        Ok(tb("expression_statement").c(&{
            let mut b_ = tb("block");
            sym("{").emit(&mut b_);
            b_.push("    ");
            b_.nl();
            {
                for c in 0..i {
