                        if c != 0 {NL.emit(&mut b_);}
                        tb("expression_statement").c(&tb("macro_invocation").c(&leaf("identifier", "println")).c(&sym("!")).c(&tb("token_tree").c(&sym("(")).c(&tb("string_literal").c(&sym("\"")).c(&leaf("string_content", "hi")).c(&sym("\"")).b()).c(&sym(")")).b()).b()).c(&sym(";")).b().emit(&mut b_);
                    }.emit(&mut b_);
                }
            };
            b_.pop();
            b_.nl();
            sym("}").emit(&mut b_);
            b_.b()
        }).b())
    }
    mk(3).unwrap()
