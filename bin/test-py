#!/usr/bin/env bash
# Test the quilt_python runtime path: the PyO3 bindings and the .py.quilt example
# programs that target them. Build the module first with `bin/build-py` (the CI
# `python` job runs build-py then test-py).
#
#   1. pytest the binding tests in quilt-python/tests/.
#   2. `quilt run` the self-contained .py.quilt examples and assert they exit 0.
#
# examples/issue_triage.html.py.quilt is intentionally excluded from (2): it
# shells out to `gh` (network + auth), so it is only `check`ed by
# bin/check-examples, never run here.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [ ! -f "$ROOT/quilt-python/quilt/_quilt.abi3.so" ]; then
  echo "error: quilt_python module not built — run 'bin/build-py' first" >&2
  exit 1
fi

echo "==> binding tests (pytest)"
( cd "$ROOT/quilt-python" && PYTHONPATH=. python3 -m pytest -q tests/ )

# The `quilt run` tests in quilt/tests/cli.rs skip themselves when the runtime
# is not built, so a plain `cargo test` stays green without maturin — which
# means the CI `Test` job, which never builds it, skips every Python one. This
# is the only place they run for real (the mirror of what bin/test-ts does for
# the Node runtime), so run them here rather than leaving argument forwarding,
# exit codes and symlinked entry points covered by nothing.
echo "==> cli integration tests (quilt run, with the runtime built)"
cargo test --quiet --manifest-path "$ROOT/Cargo.toml" -p quiltlang --test cli

echo "==> run self-contained .py.quilt examples"
for ex in hello expr_compose pow_specialize staged_pow reduce upper_tri_mul; do
  echo "--- $ex.py.quilt"
  "$ROOT/bin/quilt" "examples/$ex.py.quilt" >/dev/null
done

# The notebook example's Python cells quote HTML, which is the runtime this
# script builds — so this is where it runs for real. `--strict`: a failed cell
# other than the one wgsl cell the tour deliberately includes is a regression.
# Rendered to a scratch file so the committed tour.html stays the reviewed one.
echo "==> run the notebook example"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
"$ROOT/bin/quilt" notebook examples/notebook/tour.html.quilt -o "$tmp/tour.html" 2>"$tmp/tour.err" \
  || { cat "$tmp/tour.err" >&2; exit 1; }
if ! grep -q '1 failed' "$tmp/tour.err"; then
  echo "error: expected exactly the wgsl cell to fail:" >&2
  cat "$tmp/tour.err" >&2
  exit 1
fi
grep -q 'the dearest drink is <b>latte</b>' "$tmp/tour.html" \
  || { echo "error: the tour's headline was not rewritten" >&2; exit 1; }
echo "py runtime OK ✓"
