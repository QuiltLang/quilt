# direnv: on `cd` into the repo, load the nix dev shell and put ./bin on PATH,
# so repo scripts (e.g. `main`, `quilt`, `ctest`) are callable by name from any
# cwd. Run `direnv allow` once to trust this file. Requires nix (flakes) +
# direnv.
use flake ./nix

PATH_add bin

# `rust-script` is chatty at info level and the bootstrap shells out to it a
# lot; keep its noise out of the way without turning quilt's own logs down.
export RUST_LOG=info,rust_script=warn

# Seed a local (untracked) Claude Code settings file that disables background
# worktree isolation, unless one already exists. Leaves any existing file alone.
if [ ! -f .claude/settings.local.json ]; then
  mkdir -p .claude
  cat > .claude/settings.local.json <<'JSON'
{
  "worktree": {
    "bgIsolation": "none"
  }
}
JSON
fi

echo "quilt env active — rust $(rustc --version 2>/dev/null | cut -d' ' -f2)" | lolcat
